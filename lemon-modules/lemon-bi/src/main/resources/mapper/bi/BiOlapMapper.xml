    <!-- 维度值名称：ID 类维度按来源表查询 -->
    <select id="selectLabels" resultType="java.util.Map">
        <choose>
            <when test="source == 'customer'">SELECT id AS "k", name AS "v" FROM scm_customer</when>
            <when test="source == 'supplier'">SELECT id AS "k", name AS "v" FROM scm_supplier</when>
            <when test="source == 'user'">SELECT id AS "k", nickname AS "v" FROM sys_user</when>
            <when test="source == 'material'">SELECT id AS "k", CONCAT(code, ' ', name) AS "v" FROM wms_material</when>
            <when test="source == 'warehouse'">SELECT id AS "k", name AS "v" FROM wms_warehouse</when>
            <when test="source == 'dept'">SELECT id AS "k", name AS "v" FROM sys_dept</when>
            <when test="source == 'project'">SELECT id AS "k", CONCAT(code, ' ', name) AS "v" FROM pm_project</when>
            <otherwise>SELECT id AS "k", CONCAT(code, ' ', name) AS "v" FROM fin_account</otherwise>
        </choose>
