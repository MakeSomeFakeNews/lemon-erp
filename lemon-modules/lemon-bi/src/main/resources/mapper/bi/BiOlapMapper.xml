<mapper namespace="com.lemon.erp.modules.bi.mapper.BiOlapMapper">

    <select id="pivotSales" resultType="java.util.Map">
        SELECT
            <choose>
                <when test="q.row == 'year'">FLOOR(f.period / 100)</when>
                <when test="q.row == 'quarter'">CONCAT(FLOOR(f.period / 100), '-Q', FLOOR((MOD(f.period, 100) + 2) / 3))</when>
                <when test="q.row == 'period'">f.period</when>
                <when test="q.row == 'customer'">f.customer_id</when>
                <when test="q.row == 'owner'">f.owner_id</when>
                <when test="q.row == 'material'">f.material_id</when>
                <when test="q.row == 'category'">f.category</when>
                <when test="q.row == 'warehouse'">f.warehouse_id</when>
                <when test="q.row == 'dept'">f.dept_id</when>
                <when test="q.row == 'level'">c.level</when>
                <when test="q.row == 'industry'">x.industry</when>
                <otherwise>'-'</otherwise>
            </choose> AS "r",
            <choose>
                <when test="q.col == 'year'">FLOOR(f.period / 100)</when>
                <when test="q.col == 'quarter'">CONCAT(FLOOR(f.period / 100), '-Q', FLOOR((MOD(f.period, 100) + 2) / 3))</when>
                <when test="q.col == 'period'">f.period</when>
                <when test="q.col == 'customer'">f.customer_id</when>
                <when test="q.col == 'owner'">f.owner_id</when>
                <when test="q.col == 'material'">f.material_id</when>
                <when test="q.col == 'category'">f.category</when>
                <when test="q.col == 'warehouse'">f.warehouse_id</when>
                <when test="q.col == 'dept'">f.dept_id</when>
                <when test="q.col == 'level'">c.level</when>
                <when test="q.col == 'industry'">x.industry</when>
                <otherwise>'-'</otherwise>
            </choose> AS "c",
            SUM(f.qty) AS "qty",
            SUM(f.amount) AS "amount",
            SUM(f.cost) AS "cost",
            SUM(f.profit) AS "profit",
            COUNT(DISTINCT f.doc_no) AS "docs",
            COUNT(DISTINCT f.customer_id) AS "customers"
        FROM bi_fact_sales f
        LEFT JOIN scm_customer c ON c.id = f.customer_id
        LEFT JOIN crm_customer x ON x.customer_id = f.customer_id
        <where>
            <if test="q.begin != null">f.biz_date &gt;= #{q.begin}</if>
            <if test="q.end != null">AND f.biz_date &lt;= #{q.end}</if>
            <if test="q.filters != null">
                <foreach collection="q.filters" index="key" item="vals">
                    <if test="vals != null and vals.size() > 0">
                        AND
                        <choose>
                            <when test="key == 'year'">FLOOR(f.period / 100)</when>
                            <when test="key == 'quarter'">CONCAT(FLOOR(f.period / 100), '-Q', FLOOR((MOD(f.period, 100) + 2) / 3))</when>
                            <when test="key == 'period'">f.period</when>
                            <when test="key == 'customer'">f.customer_id</when>
                            <when test="key == 'owner'">f.owner_id</when>
                            <when test="key == 'material'">f.material_id</when>
                            <when test="key == 'category'">f.category</when>
                            <when test="key == 'warehouse'">f.warehouse_id</when>
                            <when test="key == 'dept'">f.dept_id</when>
                            <when test="key == 'level'">c.level</when>
                            <when test="key == 'industry'">x.industry</when>
                            <otherwise>'-'</otherwise>
                        </choose>
                        IN <foreach collection="vals" item="v" open="(" separator="," close=")">#{v}</foreach>
                    </if>
                </foreach>
            </if>
        </where>
        GROUP BY
            <choose>
                <when test="q.row == 'year'">FLOOR(f.period / 100)</when>
                <when test="q.row == 'quarter'">CONCAT(FLOOR(f.period / 100), '-Q', FLOOR((MOD(f.period, 100) + 2) / 3))</when>
                <when test="q.row == 'period'">f.period</when>
                <when test="q.row == 'customer'">f.customer_id</when>
                <when test="q.row == 'owner'">f.owner_id</when>
                <when test="q.row == 'material'">f.material_id</when>
                <when test="q.row == 'category'">f.category</when>
                <when test="q.row == 'warehouse'">f.warehouse_id</when>
                <when test="q.row == 'dept'">f.dept_id</when>
                <when test="q.row == 'level'">c.level</when>
                <when test="q.row == 'industry'">x.industry</when>
                <otherwise>'-'</otherwise>
            </choose>,
            <choose>
                <when test="q.col == 'year'">FLOOR(f.period / 100)</when>
                <when test="q.col == 'quarter'">CONCAT(FLOOR(f.period / 100), '-Q', FLOOR((MOD(f.period, 100) + 2) / 3))</when>
                <when test="q.col == 'period'">f.period</when>
                <when test="q.col == 'customer'">f.customer_id</when>
                <when test="q.col == 'owner'">f.owner_id</when>
                <when test="q.col == 'material'">f.material_id</when>
                <when test="q.col == 'category'">f.category</when>
                <when test="q.col == 'warehouse'">f.warehouse_id</when>
                <when test="q.col == 'dept'">f.dept_id</when>
                <when test="q.col == 'level'">c.level</when>
                <when test="q.col == 'industry'">x.industry</when>
                <otherwise>'-'</otherwise>
            </choose>
        ORDER BY 1, 2
        LIMIT 5000
    </select>

