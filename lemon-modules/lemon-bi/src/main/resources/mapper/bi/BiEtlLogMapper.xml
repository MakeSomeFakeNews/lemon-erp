<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemon.erp.modules.bi.mapper.BiEtlLogMapper">

    <select id="selectPageList" resultType="com.lemon.erp.modules.bi.entity.BiEtlLog">
        SELECT l.*, u.nickname AS create_by_name
        FROM bi_etl_log l
        LEFT JOIN sys_user u ON u.id = l.create_by
        <where>
            <if test="status != null and status != ''">l.status = #{status}</if>
        </where>
        ORDER BY l.id DESC
    </select>

</mapper>
