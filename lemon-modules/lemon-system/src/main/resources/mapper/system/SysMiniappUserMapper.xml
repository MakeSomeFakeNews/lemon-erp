<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemon.erp.modules.system.mapper.SysMiniappUserMapper">

    <select id="selectByOpenid" resultType="com.lemon.erp.modules.system.entity.SysMiniappUser">
        SELECT id, tenant_id, user_id, openid, create_time, update_time
        FROM sys_miniapp_user
        WHERE openid = #{openid}
        ORDER BY tenant_id
    </select>
</mapper>
