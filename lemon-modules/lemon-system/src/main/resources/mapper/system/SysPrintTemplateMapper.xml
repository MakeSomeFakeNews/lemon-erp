<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemon.erp.modules.system.mapper.SysPrintTemplateMapper">

    <select id="selectJrxmlIds" resultType="java.lang.Long">
        SELECT id FROM sys_print_template WHERE jrxml IS NOT NULL
    </select>

    <select id="lockByKey" resultType="java.lang.Long">
        SELECT id FROM sys_print_template WHERE template_key = #{templateKey} FOR UPDATE
    </select>
</mapper>
