<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemon.erp.modules.wms.mapper.WmsDocSequenceMapper">

    <update id="increment">
        UPDATE wms_doc_sequence SET seq_value = seq_value + 1 WHERE seq_key = #{key}
    </update>

    <insert id="insertFirst">
        INSERT INTO wms_doc_sequence (seq_key, seq_value) VALUES (#{key}, 1)
    </insert>

    <select id="selectValue" resultType="long">
        SELECT seq_value FROM wms_doc_sequence WHERE seq_key = #{key}
    </select>

</mapper>
