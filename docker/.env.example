# 复制为 .env 后修改（.env 不要提交到代码仓库）
#   cp .env.example .env

# 访问端口：浏览器访问 http://服务器地址:WEB_PORT
WEB_PORT=80

# 数据库与缓存密码（请替换为强密码）
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-db
REDIS_PASSWORD=change-me-redis

# 登录令牌签名密钥，至少 32 字节，可用 openssl rand -base64 48 生成
JWT_SECRET=change-me-please-use-openssl-rand-base64-48

# SaaS 多租户（登录时需要填写租户「柠檬科技」）
LEMON_TENANT_ENABLED=false
# 演示模式：所有用户只能查看，不能新增、修改、删除
LEMON_DEMO_ENABLED=false

# 后端 JVM 内存
JAVA_OPTS=-Xms512m -Xmx1g

# 镜像名称与标签（build.sh 推送到镜像仓库时使用，例如 registry.example.com/lemon/lemon-erp）
IMAGE_PREFIX=lemon-erp
IMAGE_TAG=latest

# 国内网络构建前端镜像时可指定 npm 镜像
NPM_REGISTRY=
